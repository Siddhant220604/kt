# Backend API base URL (no trailing /api - the client appends it)
REACT_APP_BACKEND_URL=http://localhost:8000

# Google Maps browser key, used only for the "Select on map" pin picker and the admin
# order-location preview. This is baked into the JS bundle and is visible to anyone, so it must
# be a SEPARATE key from the backend's GOOGLE_MAPS_API_KEY, restricted in the Cloud console to:
#   - Application restriction: HTTP referrers (your site's domains)
#   - API restriction: Maps JavaScript API only
# Leave it blank to ship without the map picker; address autocomplete still works without it.
REACT_APP_GOOGLE_MAPS_KEY=
